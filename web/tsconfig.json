{
  "compilerOptions": {
    // The browser floor is set by `build.target` in vite.config.ts.
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node", "svelte", "vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "checkJs": true,
    "allowJs": true
  },
  "include": ["src", "tests", "*.ts", "*.js"]
}
